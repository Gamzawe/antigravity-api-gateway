# Local development: npm start then open http://localhost:8080/console/
HOST=127.0.0.1
PORT=8080
PUBLIC_URL=http://localhost:8080
DATA_DIR=./data
# Optional existing inference-only keys. Normally leave blank and create keys in the website.
API_KEYS=
FALLBACK=false
DEBUG=false
# VPS Docker Compose: change PUBLIC_URL to https://api.yourdomain.com
# and DOMAIN to api.yourdomain.com. Point domain DNS at the VPS first.
DOMAIN=
