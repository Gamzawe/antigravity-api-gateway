[Unit]
Description=Antigravity Universal AI API Gateway
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/antigravity-api-gateway
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
EnvironmentFile=-/opt/antigravity-api-gateway/.env

# Security sandbox
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
